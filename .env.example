ADMIN_PASSWORD=change-me-please
SESSION_SECRET=replace-with-64-hex-chars
DB_PATH=./data/release-hub.db

# Comma-separated owner/repo pairs to pull releases from.
GITHUB_REPOS=abim70750-commits/your-app-repo

# Optional but recommended. Fine-grained PAT, public repo read.
# Without it: 60 req/hour. With it: 5000 req/hour.
GITHUB_TOKEN=
